+#ifdef SDL_GPU_METAL
+extern void *METAL_GetNativeDevice(SDL_GPURenderer *driverData);
+extern void *METAL_GetNativeCommandBuffer(SDL_GPUCommandBuffer *commandBuffer);
+extern void *METAL_GetNativeTexture(SDL_GPUTexture *texture);
+extern void *METAL_GetNativeBuffer(SDL_GPUBuffer *buffer);
+extern void *METAL_GetNativeRenderEncoder(SDL_GPUCommandBuffer *commandBuffer);
+#endif
+
+void *SDL_GetGPUDeviceMetalDevice(SDL_GPUDevice *device)
+{
+    CHECK_DEVICE_MAGIC(device, NULL);
+#ifdef SDL_GPU_METAL
+    if (SDL_strcmp(device->backend, "metal") == 0) {
+        return METAL_GetNativeDevice(device->driverData);
+    }
+#endif
+    SDL_Unsupported();
+    return NULL;
+}
+
+void *SDL_GetGPUCommandBufferMetalCommandBuffer(SDL_GPUCommandBuffer *command_buffer)
+{
+    if (command_buffer == NULL) {
+        SDL_InvalidParamError("command_buffer");
+        return NULL;
+    }
+#ifdef SDL_GPU_METAL
+    SDL_GPUDevice *device = ((CommandBufferCommonHeader *)command_buffer)->device;
+    if (device && SDL_strcmp(device->backend, "metal") == 0) {
+        return METAL_GetNativeCommandBuffer(command_buffer);
+    }
+#endif
+    SDL_Unsupported();
+    return NULL;
+}
+
+void *SDL_GetGPUTextureMetalTexture(SDL_GPUDevice *device, SDL_GPUTexture *texture)
+{
+    CHECK_DEVICE_MAGIC(device, NULL);
+    if (texture == NULL) {
+        SDL_InvalidParamError("texture");
+        return NULL;
+    }
+#ifdef SDL_GPU_METAL
+    if (SDL_strcmp(device->backend, "metal") == 0) {
+        return METAL_GetNativeTexture(texture);
+    }
+#endif
+    SDL_Unsupported();
+    return NULL;
+}
+
+void *SDL_GetGPUBufferMetalBuffer(SDL_GPUDevice *device, SDL_GPUBuffer *buffer)
+{
+    CHECK_DEVICE_MAGIC(device, NULL);
+    if (buffer == NULL) {
+        SDL_InvalidParamError("buffer");
+        return NULL;
+    }
+#ifdef SDL_GPU_METAL
+    if (SDL_strcmp(device->backend, "metal") == 0) {
+        return METAL_GetNativeBuffer(buffer);
+    }
+#endif
+    SDL_Unsupported();
+    return NULL;
+}
+
+void *SDL_GetGPURenderPassMetalEncoder(SDL_GPURenderPass *render_pass)
+{
+    if (render_pass == NULL) {
+        SDL_InvalidParamError("render_pass");
+        return NULL;
+    }
+#ifdef SDL_GPU_METAL
+    SDL_GPUCommandBuffer *command_buffer = ((RenderPass *)render_pass)->command_buffer;
+    SDL_GPUDevice *device = command_buffer ? ((CommandBufferCommonHeader *)command_buffer)->device : NULL;
+    if (device && SDL_strcmp(device->backend, "metal") == 0) {
+        return METAL_GetNativeRenderEncoder(command_buffer);
+    }
+#endif
+    SDL_Unsupported();
+    return NULL;
+}
