 #endif /* SDL_PLATFORM_GDK */
 
+/* openiw2 patch (tools/sdl/sdl-3.4.20-metal-handles.patch): the native Metal objects behind GPU handles, so an application can
+   encode Metal work (e.g. MetalFX or ray tracing) into SDL's command buffers. NULL (and SDL_GetError set) on other backends. */
+#define SDL_GPU_OPENIW2_METAL_HANDLES 1
+
+/**
+ * Get the id<MTLDevice> of a GPU device created with the Metal backend.
+ *
+ * \param device a GPU context.
+ * \returns the device as a void pointer (not retained), or NULL on other backends.
+ */
+extern SDL_DECLSPEC void * SDLCALL SDL_GetGPUDeviceMetalDevice(SDL_GPUDevice *device);
+
+/**
+ * Get the id<MTLCommandBuffer> of a command buffer of the Metal backend. Encode native work only between SDL passes (no SDL
+ * render, compute or copy pass open on the command buffer).
+ *
+ * \param command_buffer a command buffer.
+ * \returns the command buffer as a void pointer (not retained), or NULL on other backends.
+ */
+extern SDL_DECLSPEC void * SDLCALL SDL_GetGPUCommandBufferMetalCommandBuffer(SDL_GPUCommandBuffer *command_buffer);
+
+/**
+ * Get the id<MTLTexture> that a texture of the Metal backend currently refers to (a texture that is cycled changes it).
+ *
+ * \param device a GPU context.
+ * \param texture a texture.
+ * \returns the texture as a void pointer (not retained), or NULL on other backends.
+ */
+extern SDL_DECLSPEC void * SDLCALL SDL_GetGPUTextureMetalTexture(SDL_GPUDevice *device, SDL_GPUTexture *texture);
+
+/**
+ * Get the id<MTLBuffer> that a buffer of the Metal backend currently refers to (a buffer that is cycled changes it).
+ *
+ * \param device a GPU context.
+ * \param buffer a buffer.
+ * \returns the buffer as a void pointer (not retained), or NULL on other backends.
+ */
+extern SDL_DECLSPEC void * SDLCALL SDL_GetGPUBufferMetalBuffer(SDL_GPUDevice *device, SDL_GPUBuffer *buffer);
+
+/**
+ * Get the id<MTLRenderCommandEncoder> of an open render pass of the Metal backend, to bind native resources (e.g. an
+ * acceleration structure) at buffer indices SDL does not use (above the pipeline's uniform and storage buffers).
+ *
+ * \param render_pass a render pass.
+ * \returns the encoder as a void pointer (not retained), or NULL on other backends.
+ */
+extern SDL_DECLSPEC void * SDLCALL SDL_GetGPURenderPassMetalEncoder(SDL_GPURenderPass *render_pass);
+
 #ifdef __cplusplus
 }
 #endif /* __cplusplus */
