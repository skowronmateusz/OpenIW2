@@ -700,6 +700,34 @@
 
 // Quit
 
+// openiw2 patch: native handles (SDL_GetGPUDeviceMetalDevice and friends in SDL_gpu.c)
+void *METAL_GetNativeDevice(SDL_GPURenderer *driverData)
+{
+    return (__bridge void *)((MetalRenderer *)driverData)->device;
+}
+
+void *METAL_GetNativeCommandBuffer(SDL_GPUCommandBuffer *commandBuffer)
+{
+    return (__bridge void *)((MetalCommandBuffer *)commandBuffer)->handle;
+}
+
+void *METAL_GetNativeTexture(SDL_GPUTexture *texture)
+{
+    MetalTextureContainer *container = (MetalTextureContainer *)texture;
+    return container->activeTexture ? (__bridge void *)container->activeTexture->handle : NULL;
+}
+
+void *METAL_GetNativeBuffer(SDL_GPUBuffer *buffer)
+{
+    MetalBufferContainer *container = (MetalBufferContainer *)buffer;
+    return container->activeBuffer ? (__bridge void *)container->activeBuffer->handle : NULL;
+}
+
+void *METAL_GetNativeRenderEncoder(SDL_GPUCommandBuffer *commandBuffer)
+{
+    return (__bridge void *)((MetalCommandBuffer *)commandBuffer)->renderEncoder;
+}
